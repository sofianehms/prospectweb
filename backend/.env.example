# ═══════════════════════════════════════════════════════
# Backend — variables d'environnement
# Copier ce fichier en .env et remplir les valeurs.
# ═══════════════════════════════════════════════════════

# ── Serveur ──────────────────────────────────────────
PORT=4000
FRONTEND_URL=http://localhost:3000
# Secret partagé entre le frontend Next.js et le backend Express.
# Générer avec : node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
BACKEND_SECRET=

# ── Base de données ──────────────────────────────────
# PostgreSQL (Neon, Supabase, Railway, ou local).
DATABASE_URL=
# Redis (Upstash, Railway, ou local). Utilisé pour le cache et le rate-limit.
REDIS_URL=

# ── Google Places API ────────────────────────────────
# Clé API restreinte (référents/IP serveur, APIs autorisées : Places API New).
GOOGLE_PLACES_KEY=
# Quota global quotidien (toutes requêtes Google confondues).
GOOGLE_DAILY_LIMIT=500
# Quota par utilisateur par jour.
USER_DAILY_LIMIT=100

# ── Authentification (Clerk) ─────────────────────────
# Secret Key depuis le dashboard Clerk > API Keys.
CLERK_SECRET_KEY=
# JWT Secret pour la vérification des tokens (si utilisé hors Clerk).
JWT_SECRET=

# ── Paiement (Stripe) ───────────────────────────────
# Secret Key depuis le dashboard Stripe > Developers > API keys.
STRIPE_SECRET_KEY=
# Webhook signing secret : Stripe > Developers > Webhooks > Signing secret.
STRIPE_WEBHOOK_SECRET=
# Price IDs des plans payants (Stripe > Products > Price ID).
STRIPE_PRICE_PRO=
STRIPE_PRICE_BUSINESS=

# ── E-mails transactionnels (Resend) ────────────────
# API Key depuis resend.com/api-keys.
RESEND_API_KEY=
# Adresse d'envoi (domaine vérifié dans Resend).
RESEND_FROM=noreply@votredomaine.fr

# ── Alertes opérationnelles ─────────────────────────
# Adresse e-mail pour les alertes (circuit-breaker, quota, paiement échoué).
ALERT_EMAIL=

# ── Monitoring (Sentry) ─────────────────────────────
# DSN depuis sentry.io > Settings > Client Keys.
SENTRY_DSN=

# ── Anti-bot / website checker ──────────────────────
# Nombre de vérifications de sites web simultanées (défaut : 5).
WEBSITE_CHECK_CONCURRENCY=5

# ── Optionnel ────────────────────────────────────────
NODE_ENV=development
