# ── Variables d'environnement ──────────────────────────────────────────────────
# Copier ce fichier en .env et remplir les valeurs

# Backend
PORT=4000
FRONTEND_URL=http://localhost:3000

# Google Places API (Nearby Search + Geocoding)
GOOGLE_PLACES_KEY=

# Secret partagé frontend <-> backend (générer avec: openssl rand -hex 32)
BACKEND_SECRET=

# Quotas journaliers
GOOGLE_DAILY_LIMIT=500
USER_DAILY_LIMIT=100

# Auth JWT (générer avec: openssl rand -hex 32)
JWT_SECRET=

# Redis (optionnel en dev local, requis en prod)
REDIS_URL=

# PostgreSQL (optionnel en dev local, requis en prod)
DATABASE_URL=
